# Copie para .env e preencha. O .env não vai para o GitHub (está no .gitignore).
# Chave gratuita do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-aqui

# Pasta com os CSVs da Olist. Use data/amostra para a amostra sintética.
COPILOTO_DADOS=data/olist

# Opcional: modelo do Gemini (todos com plano gratuito). Se o limite apertar, use o Flash-Lite.
# COPILOTO_MODELO=gemini-3.8-flash
# COPILOTO_MODELO=gemini-3.5-flash-lite
